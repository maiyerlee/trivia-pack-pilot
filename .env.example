# Tracked template. `.env` (also tracked) holds only public Supabase values.
# Secrets go in `.env.local` (gitignored via *.local) for local dev, and in
# Lovable → Settings → Secrets for deployed environments. Same names everywhere.

# ── Supabase (public values, already in .env) ─────────────────────────────
SUPABASE_PROJECT_ID="..."
SUPABASE_URL="https://....supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="..."
VITE_SUPABASE_URL="https://....supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY=...

# ── AI provider (Bedrock spike) ────────────────────────────────────────────
# AI_PROVIDER selects the backend read by src/lib/ai-gateway.server.ts.
#   openai-compatible (default): any /chat/completions endpoint via AI_BASE_URL + AI_API_KEY
#   bedrock: Amazon Bedrock via the Vercel AI SDK provider
AI_PROVIDER=bedrock

# Model id. For Bedrock use a cross-region inference profile id, e.g.
#   us.meta.llama3-3-70b-instruct-v1:0        open-weight, no vendor form (spike default)
#   us.anthropic.claude-haiku-4-5-20251001-v1:0  requires Anthropic's one-time use-case form per account
#   us.anthropic.claude-sonnet-5
# For openai-compatible, e.g. google/gemini-2.5-flash (Lovable) or llama3.2 (Ollama).
AI_MODEL=us.meta.llama3-3-70b-instruct-v1:0

# openai-compatible only
AI_BASE_URL=https://ai.gateway.lovable.dev/v1
AI_API_KEY=...

# bedrock only. Bearer key (Bedrock → API keys) is the simplest; it also enables
# guardrail injection. IAM access keys (SigV4) work for calls but the guardrail
# is skipped in that mode — see ai-gateway.server.ts.
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=...
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...

# Optional Bedrock Guardrail applied to every call (input + output).
BEDROCK_GUARDRAIL_ID=...
BEDROCK_GUARDRAIL_VERSION=1

# Enables GET /api/ai-health. Unset → the route returns 404. Send the value in
# the `x-ai-health` request header. Generate with: openssl rand -hex 24
AI_HEALTH_SECRET=...
